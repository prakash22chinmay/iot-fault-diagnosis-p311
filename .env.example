# ====================================================================
# Project P_311: Knowledge driven IoT fault diagnosis assistant
# Configuration Environment Variables
# ====================================================================

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=false

# MQTT Broker (Uses reliable public broker by default, or set your own)
MQTT_BROKER_HOST=broker.emqx.io
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# LLM Diagnostics Provider ("gemini", "openai", "ollama", "expert_fallback")
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Optional OpenAI or Ollama Settings
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# 24/7 Universal Remote Access Tunnel (Cloudflare Quick Tunnel)
ENABLE_PUBLIC_TUNNEL=true
TUNNEL_PROVIDER=cloudflare
